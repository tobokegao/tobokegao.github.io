{{- /* One page per activity-log row (data/timeline.json, news.json, autolog.json), so each
   row of NEWS.LOG opens its own page at /news/<yyyymmdd>-<hash>/. The same rows and the
   same id are built in layouts/_partials/timeline.html. Articles (content/post) are
   pages already and are not repeated here. */ -}}
{{- $manual := slice -}}
{{- range hugo.Data.timeline }}{{ if eq .kind "release" }}{{ $manual = $manual | append .date }}{{ end }}{{ end -}}
{{- $rows := slice -}}
{{- range hugo.Data.timeline }}{{ $rows = $rows | append . }}{{ end -}}
{{- range hugo.Data.news }}{{ $rows = $rows | append . }}{{ end -}}
{{- range hugo.Data.autolog }}{{ if not (in $manual .date) }}{{ $rows = $rows | append . }}{{ end }}{{ end -}}
{{- range $rows -}}
  {{- $id := printf "%s-%s" (replace .date "-" "") (substr (md5 .ja) 0 6) -}}
  {{- $.AddPage (dict
      "path" $id
      "kind" "page"
      "title" .ja
      "dates" (dict "date" (time.AsTime .date))
      "params" (dict "title_en" .en "row" .)
  ) -}}
{{- end -}}
