{{- /* One page per hand-written activity-log row (data/timeline.json, news.json), so each
   row of NEWS.LOG opens its own page at /news/<yyyymmdd>-<hash>/. The same rows and the
   same id are built in layouts/_partials/timeline.html. Articles (content/post) are
   pages already and are not repeated here.
   The id is the row's "id", fixed when the row was written, so the text can be reworded
   without moving the page; a row without one falls back to date + md5(ja). */ -}}
{{- $manual := slice -}}
{{- range hugo.Data.timeline }}{{ if eq .kind "release" }}{{ $manual = $manual | append .date }}{{ end }}{{ end -}}
{{- $rows := slice -}}
{{- range hugo.Data.timeline }}{{ $rows = $rows | append . }}{{ end -}}
{{- range hugo.Data.news }}{{ $rows = $rows | append . }}{{ end -}}
{{- /* feed rows (autolog.json) get no page: they only repeat the release, so the log row
   opens the release itself (see _partials/timeline.html) */ -}}
{{- range $rows -}}
  {{- $id := .id | default (printf "%s-%s" (replace .date "-" "") (substr (md5 .ja) 0 6)) -}}
  {{- $.AddPage (dict
      "path" $id
      "kind" "page"
      "title" .ja
      "dates" (dict "date" (time.AsTime .date))
      "params" (dict "title_en" .en "row" .)
  ) -}}
{{- end -}}
